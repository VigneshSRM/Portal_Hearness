# Copy to .env (python -m redmine_agent init) and fill in. Never commit .env.

# --- Redmine (required) -------------------------------------------------------
# Administration > Settings > API > "Enable REST web service" must be ticked.
REDMINE_URL=https://redmine.example.com
# Only if people open Redmine at a different address than the harness uses:
# REDMINE_PUBLIC_URL=https://redmine.example.com
# My account > API access key > Show
REDMINE_API_KEY=
# Alternative to the API key (not recommended):
# REDMINE_USERNAME=
# REDMINE_PASSWORD=
# Block every change, whatever happens (true/false):
REDMINE_READ_ONLY=false
# Internal CA certificate (PEM) if Redmine uses a company certificate:
# REDMINE_CA_BUNDLE=config/company-ca.pem
# Limit to some projects (ids or identifiers, comma-separated):
# REDMINE_PROJECTS=service-desk,customer-portal

HARNESS_TIMEZONE=Asia/Kolkata

# --- Daily overview e-mail -------------------------------------------------------
EMAIL_ENABLED=false
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=redmine-agent@example.com
DAILY_RECIPIENTS=you@example.com
DAILY_SEND_TIME=09:00

# --- Dashboard ---------------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
# Set both to require a login (recommended when DASHBOARD_HOST=0.0.0.0).
# The login name is recorded as the reviewer on approvals.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# --- Optional: LLM for `python -m redmine_agent chat` (any OpenAI-compatible API) ----------
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_BASE_URL=http://localhost:11434/v1        # Ollama (local)
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
