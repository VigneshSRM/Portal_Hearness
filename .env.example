# =====================================================================================
#  Portal Harness - your personal settings and secrets
#
#  1. Create your copy:   python harness.py init      (copies this file to .env)
#  2. Fill in the values below, in your own text editor.
#  3. Check:              python harness.py check
#
#  .env is in .gitignore - it is never committed. Do not paste these values into an AI chat.
#  Real environment variables win over .env, and .env wins over config/settings.yaml.
# =====================================================================================


# ---- STEP 1: Redmine connection (required) ------------------------------------------
# Your Redmine address (the root URL, without /issues or /projects at the end):
REDMINE_URL=https://redmine.example.com

# Your personal API key: Redmine > My account > "API access key" (right sidebar) > Show.
# The REST API must be enabled by an admin: Administration > Settings > API > "Enable REST web service".
REDMINE_API_KEY=

# Safety switch: true = the harness can never change anything in Redmine (good while you evaluate).
# Set to false when you want closures that a person approved to be applied.
REDMINE_READ_ONLY=true

# Which projects to use (ids or identifiers from the project's URL, comma-separated). Sub-projects are
# included. Strongly recommended for a big Redmine: only these projects are downloaded and shown.
# Empty = every project you can see.
REDMINE_PROJECTS=


# ---- STEP 2: Daily overview e-mail (optional) ------------------------------------------
# true = the scheduler really sends the daily e-mail. false = previews only (data/outbox/).
EMAIL_ENABLED=false

# Your mail server. Common choices (see README, "E-mail / SMTP settings"):
#   Office 365 / Microsoft 365 : smtp.office365.com   587  starttls  (needs Authenticated SMTP enabled for the mailbox)
#   Gmail / Google Workspace   : smtp.gmail.com       587  starttls  (use an App Password)
#   Company relay (no login)   : relay.yourcompany.com 25  none      (leave username/password empty)
#   SSL-only servers           : port 465 with SMTP_SECURITY=ssl
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# The "From" address of the daily e-mail:
SMTP_SENDER=redmine-agent@example.com
# Who receives the daily e-mail (comma-separated):
DAILY_RECIPIENTS=you@example.com
# What time it is sent (24h, in HARNESS_TIMEZONE), Monday-Friday by default:
DAILY_SEND_TIME=09:00


# ---- STEP 3: Web dashboard (optional) ---------------------------------------------------
# 127.0.0.1 = only this computer. 0.0.0.0 = everyone on your network (then set a login below!).
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
# Set both to require a login. The login name is recorded as the reviewer on approvals.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Address people use to open the dashboard (used for the "Review now" link in e-mails):
# DASHBOARD_PUBLIC_URL=https://redmine-agent.yourcompany.com


# ---- Speed: local copy of Redmine --------------------------------------------------------
# The dashboard keeps a local copy of your tickets (data/redmine_cache.db) so pages open instantly.
# After a one-time first download, only the changes are fetched in the background, this often (minutes):
SYNC_INTERVAL_MINUTES=5
# How far back the copy goes: every open ticket + tickets updated in the last N days (dashboard periods
# longer than this show a note). Bigger = longer first download.
SYNC_HISTORY_DAYS=180


# ---- General ---------------------------------------------------------------------------
# IANA timezone for reports, the SLA calendar and the scheduler:
HARNESS_TIMEZONE=Asia/Kolkata


# ---- Advanced (only if you need them) ----------------------------------------------------
# Browser address of Redmine for ticket links, if different from REDMINE_URL (e.g. Docker/internal DNS):
# REDMINE_PUBLIC_URL=https://redmine.example.com
# Login with username/password instead of an API key (not recommended):
# REDMINE_USERNAME=
# REDMINE_PASSWORD=
# Company certificate authority (PEM file) if Redmine uses an internal HTTPS certificate:
# REDMINE_CA_BUNDLE=config/company-ca.pem
# Set to false to turn HTTPS certificate checks off (NOT recommended - use REDMINE_CA_BUNDLE instead):
# REDMINE_VERIFY_SSL=false
# Admin API keys only: act as another Redmine user (X-Redmine-Switch-User):
# REDMINE_IMPERSONATE=
# Where local state is kept (approval queue, audit log, templates, outbox, exports):
# HARNESS_DATA_DIR=data
# Corporate proxy (standard variables, used automatically):
# HTTPS_PROXY=http://proxy.yourcompany.com:8080
# NO_PROXY=localhost,127.0.0.1


# ---- Optional: built-in chat with an LLM API key ------------------------------------------
# Not needed if you use Claude Code, Codex CLI, Gemini CLI or Copilot CLI (they use the skills).
# Only for `python harness.py chat` with any OpenAI-compatible API:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_BASE_URL=http://localhost:11434/v1        # Ollama (local, free)
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
